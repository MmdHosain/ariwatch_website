# =============================================================================
# ARIWATCH Production Environment Configuration
# Copy to .env on the production server and replace ALL placeholder values.
# Never commit your real .env file to Git.
# =============================================================================

# --- Domain & Reverse Proxy (used by Caddy / Nginx / CORS / Callbacks) ---
STORE_DOMAIN=ariwatch.ir
API_DOMAIN=api.ariwatch.ir
FRONTEND_ORIGIN=https://ariwatch.ir
API_PUBLIC_URL=https://api.ariwatch.ir
# Set to 1 behind Caddy/Nginx, or 2 behind Cloudflare + Nginx (allowed range: 0-5)
TRUST_PROXY=1

# --- PostgreSQL Database ---
POSTGRES_USER=ariwatch_prod
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=ariwatch_prod
# Optional: set DATABASE_SSL=true when connecting to external managed Postgres (Render/Neon/RDS)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=20

# --- Store Administrators & Catalog Seeding ---
# Comma-separated Iranian mobile numbers for owner admin access (no default in production)
ADMIN_MOBILES=09120000000
# Keep false in production so demo watches are not seeded
SEED_CATALOG=false

# --- Zarinpal Live Payment Gateway ---
ZARINPAL_SANDBOX=false
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# --- Production OTP SMS Bridge (REQUIRED in production) ---
# Must be HTTPS and accept POST { mobile, code } with Authorization: Bearer <token>
OTP_PROVIDER_URL=https://sms-bridge.example.com/otp
OTP_PROVIDER_TOKEN=CHANGE_ME_OTP_TOKEN

# --- Optional Integrations (leave disabled until provider credentials are ready) ---
SMS_NOTIFICATIONS_ENABLED=false
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

TOROB_ENABLED=false
TOROB_AUDIENCE=
TOROB_PUBLIC_KEY=

BASALAM_ENABLED=false
BASALAM_ACCESS_TOKEN=
BASALAM_VENDOR_ID=
BASALAM_PRICE_UNIT=

INSTAGRAM_ENABLED=false
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v26.0

PRICE_REPORT_ENABLED=false
PRICE_REPORT_URL=
PRICE_REPORT_TOKEN=
